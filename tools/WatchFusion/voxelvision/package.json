{
  "name": "voxelvision",
  "version": "1.9.7",
  "private": true,
  "type": "module",
  "description": "Interactive voxel video engine with selectable AI, luminance and fused depth paths plus replayable scored caching",
  "scripts": {
    "start": "node server.js",
    "start:lan": "set HOST=0.0.0.0&& node server.js",
    "generate:demo": "node scripts/generate-public-demo.mjs",
    "check": "node scripts/verify.mjs --syntax-only",
    "smoke:youtube-quality": "node scripts/youtube-quality-smoke.mjs",
    "smoke:capabilities": "node scripts/capability-profile-smoke.mjs",
    "smoke:live-depth": "node scripts/live-depth-stability-smoke.mjs",
    "smoke:depth-models": "node scripts/depth-model-profiles-smoke.mjs",
    "smoke:adaptive-fps": "node scripts/adaptive-fps-governor-smoke.mjs",
    "smoke:adaptive-quality": "node scripts/adaptive-quality-governor-smoke.mjs",
    "smoke:depth-cache": "node scripts/depth-cache-smoke.mjs",
    "smoke:depth-cache-reuse": "node scripts/depth-cache-reuse-smoke.mjs",
    "smoke:depth-profile-resume": "node scripts/depth-profile-resume-smoke.mjs",
    "smoke:depth-fusion-score": "node scripts/depth-fusion-score-smoke.mjs",
    "smoke:foreground-detail": "node scripts/foreground-detail-recovery-smoke.mjs",
    "smoke:depth-feedback-report": "node scripts/depth-feedback-report-smoke.mjs",
    "smoke:public-release": "node scripts/public-release-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:verbose": "node scripts/verify.mjs --verbose"
  },
  "keywords": [
    "threejs",
    "voxels",
    "webgl",
    "video-depth",
    "depth-anything",
    "depth-anything-v3",
    "webgpu",
    "web-worker-inference",
    "youtube",
    "yt-dlp",
    "ffmpeg",
    "adaptive-quality",
    "hardware-autotune",
    "bidirectional-runtime-tuning",
    "float-depth",
    "adaptive-depth-conditioning",
    "depth-diagnostics",
    "temporal-depth",
    "analyze-ahead",
    "depth-cache",
    "depth-fusion",
    "mask-guided-detail-recovery",
    "quality-scoring",
    "cache-recalibration",
    "cross-profile-cache-reuse",
    "reload-safe-cache-resume",
    "indexeddb",
    "audio-reactive"
  ],
  "author": "driftai",
  "license": "MIT"
}
