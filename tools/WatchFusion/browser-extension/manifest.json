{
  "manifest_version": 3,
  "name": "WatchFusion Media Link",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "Link the playing media area and audio of a tab you choose to WatchFusion.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "externally_connectable": {
    "ids": [
      "doioapjnmiknkdigmdoapoahlhcaikag"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Link this tab to WatchFusion"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
