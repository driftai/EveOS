    saveTheme: document.getElementById("save-theme-btn"),
    entryTagsDialog: document.getElementById("entry-tags-dialog"),
    entryTagsSourceLabel: document.getElementById("entry-tags-source-label"),
    entryTagSearch: document.getElementById("entry-tag-search"),
    pathTagsToggleRow: document.getElementById("path-tags-toggle-row"),
    pathTagsEnabled: document.getElementById("path-tags-enabled"),
    mentionTagsEnabled: document.getElementById("mention-tags-enabled"),
    entryTagTableBody: document.getElementById("entry-tag-table-body"),
    entryTagManagerCount: document.getElementById("entry-tag-manager-count"),
    shareTagHeading: document.getElementById("share-tag-heading"),
    sharedTagHelp: document.getElementById("shared-tag-help"),
    showAllEffectiveTags: document.getElementById("show-all-effective-tags-btn"),
    hideAllEffectiveTags: document.getElementById("hide-all-effective-tags-btn"),
    openTagLibrary: document.getElementById("open-tag-library-btn"),
    saveEntryTags: document.getElementById("save-entry-tags-btn"),
    moveEntryDialog: document.getElementById("move-entry-dialog"),
    moveEntrySourceLabel: document.getElementById("move-entry-source-label"),
    moveEntryDestination: document.getElementById("move-entry-destination"),
    moveEntryPlacement: document.getElementById("move-entry-placement"),
    confirmMoveEntry: document.getElementById("confirm-move-entry-btn")
  };

  let state = null;
  let config = null;
  let currentView = "files";
  let selected = null;
  let saveTimer = null;
  let physicalRoot = null;
  let imports = [];
  let physicalSearchTimer = null;
  let tagPhysicalEntries = [];
  let tagDashboard = null;
  let integrityDashboard = null;
  let lastCopiedScopeText = "";
  let lastCopiedScopeFilename = "world-book-scope.txt";
  let focusMode = false;
  let focusSidebarOpen = false;
  let focusDetailsOpen = false;
  let linkHistory = [];
  let linkDialogEditingId = "";
  let linkDialogTargetId = "";
  let linkDialogTargets = [];
  let themeDraft = null;
  let themeDialogCommitted = false;
  let draggedVirtualId = "";
  let dragExpandTimer = null;
  let lastVirtualMove = null;
  let entryTagDraft = null;


  function focusTitle() {
    if (selected?.node?.name) return selected.node.name;
    if (selected?.record?.name) return selected.record.name;

    return {
      files: "Live files",
      worldbook: "World Book",
      tags: "Tags",
      integrity: "Canon Integrity",
      imports: "Imports"
    }[currentView] || "World Book";
  }

  function updateFocusDock() {
    if (!els.focusDockTitle) return;

    els.focusDockTitle.textContent = focusTitle();
    els.focusTreeButton.textContent = focusSidebarOpen ? "Hide tree" : "Tree";
    els.focusDetailsButton.textContent = focusDetailsOpen ? "Hide details" : "Details";
    els.focusDetailsButton.setAttribute("aria-pressed", String(focusDetailsOpen));
    els.focusModeButton.setAttribute("aria-pressed", String(focusMode));
    els.focusModeButton.textContent = focusMode ? "Exit focus" : "Focus";
  }

  function closeFocusSidebar() {
    focusSidebarOpen = false;
    document.body.classList.remove("focus-sidebar-open");
    els.focusBackdrop.hidden = true;
    updateFocusDock();
  }

  function toggleFocusSidebar() {
    if (!focusMode) return;
    focusSidebarOpen = !focusSidebarOpen;
    document.body.classList.toggle("focus-sidebar-open", focusSidebarOpen);
    els.focusBackdrop.hidden = !focusSidebarOpen;
    updateFocusDock();
  }

  function setFocusDetails(open) {
    focusDetailsOpen = Boolean(open);
    document.body.classList.toggle("focus-details-open", focusDetailsOpen);
    updateFocusDock();
  }

  function setFocusMode(enabled) {
    focusMode = Boolean(enabled);
    document.body.classList.toggle("focus-mode", focusMode);
    els.focusDock.hidden = !focusMode;

    if (focusMode) {
      closeFocusSidebar();
      setFocusDetails(false);
      requestAnimationFrame(() => {
        if (!els.fileContent.hidden && !els.fileSection.hidden) {
          els.fileContent.focus({ preventScroll: true });
        }
      });
    } else {
      closeFocusSidebar();
      setFocusDetails(false);
    }

    updateFocusDock();
  }

  function toggleFocusMode() {
    setFocusMode(!focusMode);
  }

  function setStatus(message) {
    els.saveStatus.textContent = message;
  }

  function ensureUIState() {
    state.ui = state.ui || {};
    state.ui.sidebarWidth = Number(state.ui.sidebarWidth || 380);
    state.ui.lastPhysicalFolderPath = String(state.ui.lastPhysicalFolderPath || "");
    state.ui.lastVirtualFolderId = String(state.ui.lastVirtualFolderId || "root");
    state.ui.linksCollapsed = Boolean(state.ui.linksCollapsed);
    state.ui.entrySections = state.ui.entrySections && typeof state.ui.entrySections === "object" && !Array.isArray(state.ui.entrySections)
      ? state.ui.entrySections
      : {};
    state.ui.linkDirection = ["all", "outgoing", "incoming"].includes(state.ui.linkDirection)
      ? state.ui.linkDirection
      : "all";
    WB.Theme.normalizeState(state);
  }

  function selectedSectionKey() {
    if (!selected) return "";
    if (selected.source === "physical") return `physical:${selected.node.relativePath || "(root)"}`;
    if (selected.source === "virtual") return `virtual:${selected.node.id || "root"}`;
    if (selected.source === "snapshot") return `snapshot:${selected.record?.id || "import"}:${selected.node.relativePath || selected.node.name || "entry"}`;
    return "";
  }

  function entrySectionCollapsed(name) {
    ensureUIState();
    const key = selectedSectionKey();
    if (!key) return false;
    return state.ui.entrySections?.[key]?.[name] === true;
  }

  function applyEntrySectionState() {
    const key = selectedSectionKey();
    if (!key) return;
    document.querySelectorAll("#editor-panel [data-entry-section]").forEach(section => {
      const name = section.dataset.entrySection;
      const collapsed = entrySectionCollapsed(name);
      section.classList.toggle("is-collapsed", collapsed);
      const button = section.querySelector(`[data-entry-section-toggle="${name}"]`);
      if (button) {
        button.textContent = collapsed ? "Expand" : "Collapse";
        button.setAttribute("aria-expanded", collapsed ? "false" : "true");
      }
    });
  }

  function setEntrySectionCollapsed(name, collapsed) {
    ensureUIState();
    const key = selectedSectionKey();
    if (!key || !name) return;
    state.ui.entrySections[key] = state.ui.entrySections[key] || {};
    state.ui.entrySections[key][name] = Boolean(collapsed);
    applyEntrySectionState();
    scheduleStateSave();
  }

  function normalizeTaxonomy() {
    const taxonomyChanged = WB.Taxonomy.normalizeState(state);
    const linksChanged = WB.Links.normalizeState(state);
    WB.Canon.normalizeState(state);
    WB.Integrity.normalizeState(state);
    WB.Theme.normalizeState(state);
    if (taxonomyChanged || linksChanged) scheduleStateSave();
  }

  function applySidebarWidth(width) {
    const maximum = Math.max(360, Math.floor(window.innerWidth * 0.72));
    const normalized = Math.min(maximum, Math.max(280, Number(width) || 380));
    document.documentElement.style.setProperty("--sidebar-width", `${normalized}px`);
    if (state) {
      ensureUIState();
      state.ui.sidebarWidth = normalized;
    }
    return normalized;
  }

  function initSidebarResize() {
    let dragging = false;

    els.sidebarResizer.addEventListener("pointerdown", event => {
      if (window.matchMedia("(max-width: 900px)").matches) return;
      dragging = true;
      document.body.classList.add("sidebar-resizing");
      els.sidebarResizer.setPointerCapture(event.pointerId);
      event.preventDefault();
    });

    els.sidebarResizer.addEventListener("pointermove", event => {
      if (!dragging) return;
      applySidebarWidth(event.clientX);
    });

    function finishResize(event) {
      if (!dragging) return;
      dragging = false;
      document.body.classList.remove("sidebar-resizing");
      try { els.sidebarResizer.releasePointerCapture(event.pointerId); } catch (_error) {}
      scheduleStateSave();
    }

    els.sidebarResizer.addEventListener("pointerup", finishResize);
    els.sidebarResizer.addEventListener("pointercancel", finishResize);
  }


  function selectedLinks() {
    if (!selected) return [];
    if (selected.source === "physical") {
      return metaForPhysical(selected.node.relativePath || "").links;
    }
    if (selected.source === "virtual") {
      selected.node.links = WB.Links.normalizeList(selected.node.links);
      return selected.node.links;
    }
    return [];
  }

  function selectedDescriptor() {
    if (!selected) return null;
    if (selected.source === "physical") {
      return {
        source: "physical",
        path: selected.node.relativePath || "",
        name: selected.node.name || "Live entry"
      };
    }
    if (selected.source === "virtual") {
      return {
        source: "virtual",
        id: selected.node.id,
        name: selected.node.name || "World Book entry"
      };
    }
    return null;
  }

  function getLinkBackLabel() {
    const previous = linkHistory.at(-1);
    return previous ? `Back to ${previous.name}` : "";
  }

  function refreshSelectedLinks() {
    if (!selected || !["physical", "virtual"].includes(selected.source)) return;
    const links = selected.source === "virtual" ? WB.Links.forEntry(state, selected.node.id) : selectedLinks();
    WB.Editor.refreshLinks(state, links, false);
  }

  function touchSelectedLinks() {
    const timestamp = WB.nowISO();

    if (selected?.source === "physical") {
      const meta = metaForPhysical(selected.node.relativePath || "");
      meta.updatedAt = timestamp;
      els.metaUpdatedAt.textContent = new Date(timestamp).toLocaleString();
    } else if (selected?.source === "virtual") {
      selected.node.updatedAt = timestamp;
      els.modifiedAt.textContent = new Date(timestamp).toLocaleString();
      els.metaUpdatedAt.textContent = new Date(timestamp).toLocaleString();
    }

    refreshSelectedLinks();
    scheduleStateSave();
  }
