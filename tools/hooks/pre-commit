#!/bin/sh
# EveOS pre-commit runtime integrity and secret guard.
# Blocks commits with stale runtime fingerprints, disconnected browser assets, or a
# hardcoded credential. Keys belong in the user's Settings
# (config.expandedSearch), resolved at runtime -- never committed. Enable once per clone with:
#   git config core.hooksPath tools/hooks
#
# Patterns mirror tools/audit/eveos-repo-audit.js. Emergency bypass (discouraged): git commit --no-verify

patterns='AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC )?PRIVATE KEY-----|[0-9]+-[0-9a-z]{32}\.apps\.googleusercontent\.com'

# Only scan added/changed lines of staged text; skip binary and deletions.
hits=$(git diff --cached --no-color -U0 --diff-filter=ACM \
    | grep -E '^\+' \
    | grep -vE '^\+\+\+' \
    | grep -En "$patterns")

if [ -n "$hits" ]; then
    echo "COMMIT BLOCKED: a hardcoded secret was found in staged changes:" >&2
    echo "$hits" | sed -E 's/(AIza[0-9A-Za-z_-]{4})[0-9A-Za-z_-]+/\1...<redacted>/g' >&2
    echo "" >&2
    echo "Move the credential to the user's Settings (config.expandedSearch) and resolve it" >&2
    echo "at runtime. To override in a genuine false positive: git commit --no-verify" >&2
    exit 1
fi

if ! node tools/audit/sync-runtime-asset-versions.js >/dev/null; then
    echo "COMMIT BLOCKED: runtime asset fingerprints are stale." >&2
    echo "Run npm run build:asset-versions, review the generated references, then stage them." >&2
    exit 1
fi

if ! node tools/audit/runtime-asset-reachability-audit.js >/dev/null; then
    echo "COMMIT BLOCKED: a browser runtime asset is disconnected from EveOS." >&2
    echo "Run npm run audit:runtime-assets for the disconnected file list." >&2
    exit 1
fi

if ! node tools/extensions/assemble.cjs >/dev/null 2>&1; then
    echo "COMMIT BLOCKED: the EveOS Bridge extension manifest is stale." >&2
    echo "A tool extension (Nexus Browser, WatchFusion, Tab Collector) changed without a Bridge rebuild." >&2
    echo "Run npm run build:eveos-extension, then stage extension/manifest.json." >&2
    exit 1
fi

exit 0
