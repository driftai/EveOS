{
  "manifest_version": 3,
  "name": "EveOS Bridge",
  "version": "0.3.0",
  "description": "Nexus, Dex, WatchFusion, and local tab collection in one EveOS browser popup.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "optional_permissions": [
    "management"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://muse.ai/*"
  ],
  "background": {
    "service_worker": "service-worker-entry.js"
  },
  "action": {
    "default_title": "EveOS Bridge",
    "default_popup": "popup.html"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "modules/nexus-browser/content/provider-adapter-revision.js",
        "modules/nexus-browser/content/deepseek-input.js",
        "modules/nexus-browser/content/deepseek-answer.js",
        "modules/nexus-browser/content/deepseek.js",
        "modules/nexus-browser/content/activity-search.js",
        "modules/nexus-browser/content/activity.js",
        "modules/nexus-browser/content/search-recovery.js",
        "modules/nexus-browser/content/dex-provider-control.js",
        "modules/nexus-browser/content/provider-health.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://x.com/i/grok*"
      ],
      "js": [
        "modules/nexus-browser/content/provider-adapter-revision.js",
        "modules/nexus-browser/content/grok-input.js",
        "modules/nexus-browser/content/grok-answer.js",
        "modules/nexus-browser/content/grok.js",
        "modules/nexus-browser/content/grok-activity.js",
        "modules/nexus-browser/content/dex-provider-control.js",
        "modules/nexus-browser/content/provider-health.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "modules/nexus-browser/content/provider-adapter-revision.js",
        "modules/nexus-browser/content/claude-input.js",
        "modules/nexus-browser/content/claude-answer.js",
        "modules/nexus-browser/content/claude.js",
        "modules/nexus-browser/content/claude-activity-search.js",
        "modules/nexus-browser/content/claude-activity-command.js",
        "modules/nexus-browser/content/claude-activity.js",
        "modules/nexus-browser/content/dex-provider-control.js",
        "modules/nexus-browser/content/provider-health.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "modules/nexus-browser/content/provider-adapter-revision.js",
        "modules/nexus-browser/content/response-deadline.js",
        "modules/nexus-browser/content/chatgpt-page-state.js",
        "modules/nexus-browser/content/chatgpt-input.js",
        "modules/nexus-browser/content/chatgpt-delivery-watchdog.js",
        "modules/nexus-browser/content/chatgpt-answer.js",
        "modules/nexus-browser/content/chatgpt-return.js",
        "modules/nexus-browser/content/chatgpt.js",
        "modules/nexus-browser/content/chatgpt-stream-nudge.js",
        "modules/nexus-browser/content/dex-provider-control.js",
        "modules/nexus-browser/content/provider-health.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": [
        "modules/nexus-browser/content/provider-adapter-revision.js",
        "modules/nexus-browser/content/gemini-input.js",
        "modules/nexus-browser/content/gemini-answer.js",
        "modules/nexus-browser/content/gemini.js",
        "modules/nexus-browser/content/dex-provider-control.js",
        "modules/nexus-browser/content/provider-health.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://muse.ai/*"
      ],
      "js": [
        "modules/nexus-browser/content/provider-adapter-revision.js",
        "modules/nexus-browser/content/prompt-delivery.js",
        "modules/nexus-browser/content/muse-input.js",
        "modules/nexus-browser/content/muse-answer.js",
        "modules/nexus-browser/content/muse.js",
        "modules/nexus-browser/content/dex-provider-control.js",
        "modules/nexus-browser/content/provider-health.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
